package com.pes.lib

// functional programming, collections
fun main() {

    val phoneNumbers = listOf<String>("1234567890", "123", "", "0987654321")

    // 1. filter() -> keep only valid 10-digit numbers
    val validNumbers = phoneNumbers.filter { number -> number.length == 10 }

    println("Valid phone numbers (10 digits):")
    validNumbers.forEach { println(it) }

    

    // 2. forEach() -> print each number, or 'NAN' if invalid
    println("All numbers (forEach), invalid marked as NAN:")
    phoneNumbers.forEach { number ->
        if (number.length == 10) println(number) else println("NAN")
    }

    

    // 2b. map() -> same result, built as a new transformed list
    val mappedNumbers = phoneNumbers.map { number ->
        if (number.length == 10) number else "NAN"
    }

    println("All numbers (map), invalid marked as NAN:")
    mappedNumbers.forEach { println(it) }
}
